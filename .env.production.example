# ─────────────────────────────────────────────────────────────
# Production environment variables — COPY this to .env on server
# and fill in all values marked with <CHANGE_ME>
# ─────────────────────────────────────────────────────────────

# ── MySQL ──────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=<CHANGE_ME_strong_root_password>
MYSQL_PASSWORD=<CHANGE_ME_elmapi_db_password>

# ── ElmapiCMS (Laravel) ────────────────────────────────────
# php artisan key:generate --show  (run on server to get this)
ELMAPI_APP_KEY=<CHANGE_ME_base64:...>

# ── Next.js ────────────────────────────────────────────────
# ElmapiCMS project credentials (from Project settings → API Access)
ELMAPI_PROJECT_ID=df1aacd0-af59-4089-a00e-072d1236e662
ELMAPI_API_KEY=<CHANGE_ME_production_api_key>

# NextAuth secret (openssl rand -base64 32)
AUTH_SECRET=<CHANGE_ME_random_32_chars>

# ── Telegram notifications ─────────────────────────────────
TELEGRAM_BOT_TOKEN=<CHANGE_ME>
TELEGRAM_CHAT_ID=<CHANGE_ME>
